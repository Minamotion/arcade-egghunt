; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Arcade Egghunt"
config/description="You are you (fast and hungry)"
config/version="1.0.0.0"
config/tags=PackedStringArray("2d", "pixel")
run/main_scene="uid://bifft30f8vtey"
config/use_custom_user_dir=true
config/custom_user_dir_name="minamotion/egghunt"
config/auto_accept_quit=false
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=30
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="uid://cdih5v3t67pi4"
boot_splash/minimum_display_time=1000

[autoload]

Session="*res://autoloads/session.gd"
Save="*res://autoloads/save.gd"
ModSupport="res://autoloads/modsupport.gd"

[display]

window/size/viewport_width=160
window/size/viewport_height=120
window/size/window_width_override=720
window/size/window_height_override=540
window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"

[editor]

movie_writer/movie_file="/home/minamotion/Desktop/Godot/Projects/ArcadeEgghunt/.movie/movie.avi"

[global_group]

enemy="Thing that can kill the player"
egg="Thing that can get eaten by the player"

